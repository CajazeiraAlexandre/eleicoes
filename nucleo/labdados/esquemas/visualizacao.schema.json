{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cajazeiraalexandre.github.io/labdados/esquemas/visualizacao.schema.json",
  "title": "Especificação de Visualização (viz.yaml ou viz.json) — v0.2",
  "description": "L0007, L0011, L0013 e docs/arquitetura/especificacao.md. Só a estrutura: as regras que dependem do DS (componentes, papéis, tarefas, limites) são conferidas por labdados.viz.validar. Listas do DS (tarefas, formatos, estilos) não são fechadas aqui, para não engessar o DS.",
  "type": "object",
  "required": [
    "id",
    "tipo",
    "status",
    "tarefa",
    "texto",
    "dados",
    "grafico"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}_[a-z0-9-]+$"
    },
    "tipo": {
      "const": "visualizacao"
    },
    "edicao": {
      "type": [
        "string",
        "null"
      ],
      "description": "data da base desta edição (retrato datado, L0010)"
    },
    "status": {
      "enum": [
        "rascunho",
        "revisao",
        "publicado",
        "arquivado"
      ]
    },
    "origem": {
      "type": "string",
      "description": "<projeto>/<produto>@<versão>#<gráfico>, quando promovida (L0009)"
    },
    "tarefa": {
      "type": "object",
      "required": [
        "categoria",
        "pergunta"
      ],
      "additionalProperties": false,
      "properties": {
        "categoria": {
          "type": "string"
        },
        "alvo": {
          "type": "string"
        },
        "pergunta": {
          "type": "string",
          "minLength": 5
        }
      }
    },
    "texto": {
      "type": "object",
      "required": [
        "titulo"
      ],
      "additionalProperties": false,
      "properties": {
        "chapeu": {
          "type": "string"
        },
        "titulo": {
          "type": "string",
          "minLength": 3
        },
        "subtitulo": {
          "type": "string"
        },
        "como_ler": {
          "type": "string"
        },
        "notas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "afirmacoes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notas_por": {
          "type": "object"
        },
        "amostra": {
          "type": [
            "string",
            "object"
          ],
          "description": "N da amostra (texto do Python, marcador {e.…}); objeto {grafico, mapa} quando muda com a vista"
        },
        "fonte": {
          "type": "string",
          "description": "fonte em uma linha; o gerador acrescenta a data da base"
        },
        "fonte_curta": {
          "type": "string",
          "description": "fonte em poucas palavras, para a barra da peça (o gerador acrescenta a data)"
        }
      }
    },
    "dados": {
      "type": "object",
      "required": [
        "fonte",
        "decisoes"
      ],
      "additionalProperties": false,
      "properties": {
        "fonte": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "dataset": {
              "type": "string"
            },
            "analise": {
              "type": "string"
            },
            "tabela": {
              "type": "string"
            },
            "produto": {
              "type": "string"
            },
            "csv": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "consulta": {
          "type": "string"
        },
        "derivadas": {
          "type": "object"
        },
        "colunas": {
          "type": "object"
        },
        "conferencias": {
          "type": "array"
        },
        "supressao": {
          "type": "object",
          "properties": {
            "minimo": {
              "type": "integer",
              "minimum": 1
            },
            "colunas": {
              "type": "array"
            }
          }
        },
        "fatiar_por": {
          "type": "string"
        },
        "decisoes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{1,3}[0-9]{4}$"
          },
          "minItems": 1
        },
        "indice": {
          "type": "string",
          "description": "arquivo com o índice das fatias e o dicionário de colunas (ex.: data/municipios.json)"
        }
      }
    },
    "escalas": {
      "type": "object"
    },
    "grafico": {
      "type": "object",
      "required": [
        "componente",
        "ligacoes"
      ],
      "additionalProperties": false,
      "properties": {
        "componente": {
          "type": "string"
        },
        "ligacoes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": [
              "string",
              "array",
              "object"
            ]
          }
        },
        "opcoes": {
          "type": "object"
        },
        "destaque": {
          "type": "object",
          "properties": {
            "coluna": {
              "type": "string"
            },
            "fora": {
              "type": "string"
            }
          },
          "required": [
            "coluna"
          ]
        },
        "rotulos": {
          "type": "object"
        },
        "detalhe": {
          "type": "object"
        },
        "anotacoes": {
          "type": "array",
          "items": {
            "type": "object",
            "if": {
              "properties": {
                "tipo": {
                  "const": "linha"
                }
              },
              "required": [
                "tipo"
              ]
            },
            "else": {
              "required": [
                "texto"
              ]
            },
            "properties": {
              "id": {
                "type": "string"
              },
              "tipo": {
                "type": "string"
              },
              "alvo": {},
              "texto": {
                "type": "string"
              },
              "lado": {
                "type": "string"
              },
              "prioridade": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "estilo": {
                "type": "string"
              },
              "valor": {}
            }
          }
        },
        "facetas": {
          "type": "object",
          "properties": {
            "campo": {
              "type": "string"
            },
            "max": {
              "type": "integer",
              "maximum": 4
            }
          }
        },
        "companheiro": {
          "type": "object",
          "required": [
            "componente",
            "ligacoes"
          ],
          "properties": {
            "componente": {
              "type": "string"
            },
            "ligacoes": {
              "type": "object"
            },
            "escalas": {
              "type": "object"
            },
            "rotulo_aba": {
              "type": "string"
            },
            "opcoes": {
              "type": "object"
            },
            "vazio": {
              "type": "string",
              "description": "texto quando o companheiro não tem o que mostrar (marcador {e.…})"
            }
          }
        },
        "extensao": {
          "type": "string"
        }
      }
    },
    "vistas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ]
      }
    },
    "sequencia": {
      "type": "object",
      "required": [
        "passos"
      ],
      "properties": {
        "passos": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4
        },
        "depois": {
          "type": "string"
        }
      }
    },
    "legenda": {
      "type": "object"
    },
    "controles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "tipo"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "tipo": {
            "type": "string"
          },
          "campo": {
            "type": "string"
          },
          "valores": {},
          "inicial": {},
          "rotulo": {
            "type": "string"
          },
          "local": {
            "enum": [
              "titulo",
              "grafico",
              "explorar"
            ]
          },
          "obrigatorio": {
            "type": "boolean"
          },
          "modo": {
            "type": "string"
          },
          "padrao_link": {
            "type": "boolean"
          },
          "opcao": {
            "type": "string",
            "description": "opção de componente que o controle muda (forma, fundo…)"
          },
          "explorar": {
            "type": "boolean",
            "description": "também em ⇄ Explorar (além do lugar em `local`)"
          }
        }
      }
    },
    "formatos": {
      "type": "object",
      "properties": {
        "aceitos": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ajustes": {
          "type": "object"
        }
      }
    },
    "saidas": {
      "type": "object"
    },
    "estilo": {
      "type": "object",
      "description": "cores do produto (tokens claro/escuro), ex.: {tokens: {cg-lula: ['#e34948', '#e66767']}}",
      "properties": {
        "tokens": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 2
          }
        }
      },
      "additionalProperties": false
    }
  }
}
