{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cajazeiraalexandre.github.io/labdados/esquemas/visualizacao.schema.json",
  "title": "Especificação de Visualização (viz.yaml ou viz.json) — v0.2",
  "description": "L0007, L0011, L0013 e docs/arquitetura/especificacao.md. Só a estrutura: as regras que dependem do DS (componentes, papéis, tarefas, limites) são conferidas por labdados.viz.validar. Listas do DS (tarefas, formatos, estilos) não são fechadas aqui, para não engessar o DS.",
  "type": "object",
  "required": [
    "id",
    "tipo",
    "status",
    "tarefa",
    "texto",
    "dados"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}_[a-z0-9-]+$"
    },
    "tipo": {
      "enum": [
        "visualizacao",
        "story"
      ],
      "description": "story = sequência de cartões sobre o mesmo plano (hospedeiro story, Q-066)"
    },
    "edicao": {
      "type": [
        "string",
        "null"
      ],
      "description": "data da base desta edição (retrato datado, L0010)"
    },
    "status": {
      "enum": [
        "rascunho",
        "revisao",
        "publicado",
        "arquivado"
      ]
    },
    "origem": {
      "type": "string",
      "description": "<projeto>/<produto>@<versão>#<gráfico>, quando promovida (L0009)"
    },
    "tarefa": {
      "type": "object",
      "required": [
        "categoria",
        "pergunta"
      ],
      "additionalProperties": false,
      "properties": {
        "categoria": {
          "type": "string"
        },
        "alvo": {
          "type": "string"
        },
        "pergunta": {
          "type": "string",
          "minLength": 5
        }
      }
    },
    "texto": {
      "type": "object",
      "required": [
        "titulo"
      ],
      "additionalProperties": false,
      "properties": {
        "chapeu": {
          "type": "string"
        },
        "titulo": {
          "type": "string",
          "minLength": 3
        },
        "subtitulo": {
          "type": "string"
        },
        "como_ler": {
          "type": "string"
        },
        "notas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "afirmacoes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notas_por": {
          "type": "object"
        },
        "amostra": {
          "type": [
            "string",
            "object"
          ],
          "description": "N da amostra (texto do Python, marcador {e.…}); objeto {grafico, mapa} quando muda com a vista"
        },
        "fonte": {
          "type": "string",
          "description": "fonte em uma linha; o gerador acrescenta a data da base"
        },
        "fonte_curta": {
          "type": "string",
          "description": "fonte em poucas palavras, para a barra da peça (o gerador acrescenta a data)"
        }
      }
    },
    "dados": {
      "type": "object",
      "required": [
        "fonte",
        "decisoes"
      ],
      "additionalProperties": false,
      "properties": {
        "fonte": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "dataset": {
              "type": "string"
            },
            "analise": {
              "type": "string"
            },
            "tabela": {
              "type": "string"
            },
            "produto": {
              "type": "string"
            },
            "csv": {
              "type": "string"
            },
            "base": {
              "type": "string",
              "description": "arquivo JSON com a base única (sem fatias), embutida na página: {textos: {...}, colunas?, linhas?}"
            }
          },
          "additionalProperties": false
        },
        "consulta": {
          "type": "string"
        },
        "derivadas": {
          "type": "object"
        },
        "colunas": {
          "type": "object"
        },
        "conferencias": {
          "type": "array"
        },
        "supressao": {
          "type": "object",
          "properties": {
            "minimo": {
              "type": "integer",
              "minimum": 1
            },
            "colunas": {
              "type": "array"
            }
          }
        },
        "fatiar_por": {
          "type": "string"
        },
        "decisoes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{1,3}[0-9]{4}$"
          },
          "minItems": 1
        },
        "indice": {
          "type": "string",
          "description": "arquivo com o índice das fatias e o dicionário de colunas (ex.: data/municipios.json)"
        }
      }
    },
    "escalas": {
      "type": "object"
    },
    "grafico": {
      "type": "object",
      "required": [
        "componente"
      ],
      "additionalProperties": false,
      "properties": {
        "componente": {
          "type": "string"
        },
        "ligacoes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": [
              "string",
              "array",
              "object"
            ]
          }
        },
        "opcoes": {
          "type": "object"
        },
        "destaque": {
          "type": "object",
          "properties": {
            "coluna": {
              "type": "string"
            },
            "fora": {
              "type": "string"
            },
            "rotulo": {
              "type": "string"
            },
            "rotulo_dentro": {
              "type": "string"
            }
          },
          "required": [
            "coluna"
          ]
        },
        "rotulos": {
          "type": "object"
        },
        "detalhe": {
          "type": "object"
        },
        "anotacoes": {
          "type": "array",
          "items": {
            "type": "object",
            "if": {
              "properties": {
                "tipo": {
                  "const": "linha"
                }
              },
              "required": [
                "tipo"
              ]
            },
            "else": {
              "required": [
                "texto"
              ]
            },
            "properties": {
              "id": {
                "type": "string"
              },
              "tipo": {
                "type": "string"
              },
              "alvo": {},
              "texto": {
                "type": "string"
              },
              "lado": {
                "type": "string"
              },
              "prioridade": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "estilo": {
                "type": "string"
              },
              "valor": {}
            }
          }
        },
        "facetas": {
          "type": "object",
          "properties": {
            "campo": {
              "type": "string"
            },
            "max": {
              "type": "integer",
              "maximum": 4
            }
          }
        },
        "companheiro": {
          "type": "object",
          "required": [
            "componente",
            "ligacoes"
          ],
          "properties": {
            "componente": {
              "type": "string"
            },
            "ligacoes": {
              "type": "object"
            },
            "escalas": {
              "type": "object"
            },
            "rotulo_aba": {
              "type": "string"
            },
            "opcoes": {
              "type": "object"
            },
            "vazio": {
              "type": "string",
              "description": "texto quando o companheiro não tem o que mostrar (marcador {e.…})"
            }
          }
        },
        "extensao": {
          "type": "string"
        },
        "dados": {
          "type": "string",
          "description": "marcador {e.…} com os dados prontos do Python (componente de dados próprios; dispensa ligacoes — L0015, 2026-10-12)"
        }
      },
      "anyOf": [
        {
          "required": [
            "ligacoes"
          ]
        },
        {
          "required": [
            "dados"
          ]
        }
      ]
    },
    "vistas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ]
      }
    },
    "sequencia": {
      "type": "object",
      "required": [
        "passos"
      ],
      "properties": {
        "passos": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4
        },
        "depois": {
          "type": "string"
        }
      }
    },
    "legenda": {
      "type": "object"
    },
    "controles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "tipo"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "tipo": {
            "type": "string"
          },
          "campo": {
            "type": "string"
          },
          "valores": {},
          "inicial": {},
          "rotulo": {
            "type": "string"
          },
          "local": {
            "enum": [
              "titulo",
              "grafico",
              "explorar"
            ]
          },
          "obrigatorio": {
            "type": "boolean"
          },
          "modo": {
            "type": "string"
          },
          "padrao_link": {
            "type": "boolean"
          },
          "opcao": {
            "type": "string",
            "description": "opção de componente que o controle muda (forma, fundo…)"
          },
          "explorar": {
            "type": "boolean",
            "description": "também em ⇄ Explorar (além do lugar em `local`)"
          }
        }
      }
    },
    "formatos": {
      "type": "object",
      "properties": {
        "aceitos": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ajustes": {
          "type": "object"
        }
      }
    },
    "saidas": {
      "type": "object"
    },
    "estilo": {
      "type": "object",
      "description": "cores do produto (tokens claro/escuro), ex.: {tokens: {cg-lula: ['#e34948', '#e66767']}}",
      "properties": {
        "tokens": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 2
          }
        }
      },
      "additionalProperties": false
    },
    "cartoes": {
      "type": "array",
      "minItems": 2,
      "description": "story: cartões em ordem; cada um escolhe a vista (principal, mapa) ou um componente com dados próprios",
      "items": {
        "type": "object",
        "required": [
          "id",
          "titulo"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "titulo": {
            "type": "string"
          },
          "texto": {
            "type": "string"
          },
          "vista": {
            "enum": [
              "principal",
              "mapa"
            ]
          },
          "componente": {
            "type": "string"
          },
          "dados": {
            "type": "string",
            "description": "marcador {e.…} com os dados do componente"
          },
          "opcoes": {
            "type": "object"
          },
          "destaque": {
            "type": "boolean",
            "description": "false = todos os pontos na mesma cor, sem destaque"
          },
          "anotacoes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "ids de grafico.anotacoes mostradas neste cartão"
          },
          "se": {
            "type": "string",
            "pattern": "^!?[a-z_]+$",
            "description": "condição calculada no Python (textos da fatia); ! inverte"
          },
          "capa": {
            "type": "boolean"
          },
          "imagem": {
            "type": "string",
            "description": "Só na capa: id do cartão cujo gráfico ilustra a capa (estático, esmaecido) — proposta de 2026-10-12"
          },
          "fim": {
            "type": "boolean"
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "rotulo",
                "href"
              ],
              "properties": {
                "rotulo": {
                  "type": "string"
                },
                "href": {
                  "type": "string"
                }
              }
            }
          },
          "capitulo": {
            "type": "string",
            "description": "nome do capítulo, no lugar do chapéu"
          },
          "nota": {
            "type": "string",
            "description": "nota curta sob o gráfico (fonte, definição, limite)"
          },
          "componentes": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "description": "pilha de componentes no palco (ex.: mapa em cima, barras embaixo)",
            "items": {
              "type": "object",
              "required": [
                "componente",
                "dados"
              ],
              "additionalProperties": false,
              "properties": {
                "componente": {
                  "type": "string"
                },
                "dados": {
                  "type": "string"
                },
                "opcoes": {
                  "type": "object"
                },
                "altura": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "rotulo": {
                  "type": "string",
                  "description": "nome curto do gráfico, acima dele (ex.: '2022' e '2026') — proposta de 2026-10-12"
                }
              }
            }
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "vista",
                "componente"
              ]
            },
            {
              "required": [
                "vista",
                "componentes"
              ]
            },
            {
              "required": [
                "componente",
                "componentes"
              ]
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "tipo": {
            "const": "story"
          }
        },
        "required": [
          "tipo"
        ]
      },
      "then": {
        "required": [
          "cartoes"
        ]
      }
    }
  ]
}
